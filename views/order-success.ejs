<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
  <div class="container">

    <div class="row justify-content-center">

      <div class="col-lg-6">

        <div class="card shadow border-0 text-center">

          <div class="card-body p-5">

            <div class="mb-4">
              <i class="fa-solid fa-circle-check text-success fa-5x"></i>
            </div>

            <h1 class="fw-bold mb-3">
              Order Confirmed!
            </h1>

            <p class="text-muted mb-4">
              Thank you for shopping with <strong>TEAM SAVAGE</strong>.
              Your order has been received successfully.
            </p>

            <div class="bg-light rounded p-3 mb-4">

              <p class="mb-2">
                <strong>Order Number:</strong>
              </p>

              <h5 class="text-warning mb-0">
                #<%= order._id.toString().slice(-6).toUpperCase() %>
              </h5>

            </div>

            <div class="row text-center mb-4">

              <div class="col-6">

                <p class="small text-muted mb-1">Status</p>

                <p class="fw-bold mb-0">
                  <%= order.status %>
                </p>

              </div>

              <div class="col-6">

                <p class="small text-muted mb-1">Total</p>

                <p class="fw-bold text-warning mb-0">
                  R<%= order.total.toFixed(2) %>
                </p>

              </div>

            </div>

            <div class="d-grid gap-3">

              <a href="/shop" class="btn btn-warning btn-lg">
                <i class="fa-solid fa-store me-2"></i>
                Continue Shopping
              </a>

              <a href="/" class="btn btn-outline-dark">
                Back to Home
              </a>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<%- include("partials/footer") %>