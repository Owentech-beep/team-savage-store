<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="py-5 mt-5 bg-white text-dark">

  <div class="container">

    <div class="row align-items-center g-5">

      <!-- ========================================= -->
      <!-- PRODUCT IMAGE -->
      <!-- ========================================= -->

      <div class="col-lg-6">

        <div class="product-details-image p-4 text-center">

          <img
            src="<%= product.image %>"
            class="img-fluid"
            alt="<%= product.name %>">

        </div>

      </div>


      <!-- ========================================= -->
      <!-- PRODUCT DETAILS -->
      <!-- ========================================= -->

      <div class="col-lg-6">

        <p class="text-uppercase text-secondary fw-semibold mb-2">
          <%= product.category %>
        </p>

        <h1 class="display-5 fw-bold mb-3">
          <%= product.name %>
        </h1>

        <p class="fs-2 fw-bold text-warning mb-4">
          R<%= Number(product.price).toFixed(2) %>
        </p>

        <p class="text-muted mb-4">
          <%= product.description ||
            "Premium performance products designed for performance, comfort, durability, and savage energy." %>
        </p>


        <!-- ========================================= -->
        <!-- CLOTHING: SIZE-BASED STOCK -->
        <!-- ========================================= -->

        <% if (product.category === "Clothing") { %>

          <div class="mb-4">

            <label class="form-label fw-bold">
              Select Size
            </label>

            <select
              class="form-select product-size"
              required>

              <option value="">
                Choose size
              </option>

              <% if (product.sizes && product.sizes.length > 0) { %>

                <% product.sizes.forEach(sizeItem => { %>

                  <option
                    value="<%= sizeItem.size %>"
                    data-stock="<%= sizeItem.stock %>"
                    <%= sizeItem.stock <= 0 ? "disabled" : "" %>>

                    <%= sizeItem.size %>

                    <% if (sizeItem.stock <= 0) { %>
                      — Out of Stock
                    <% } else { %>
                      — <%= sizeItem.stock %> left
                    <% } %>

                  </option>

                <% }) %>

              <% } %>

            </select>

            <small class="text-muted size-stock-message">
              Select a size to see availability.
            </small>

          </div>


        <!-- ========================================= -->
        <!-- ACCESSORIES: NORMAL STOCK -->
        <!-- ========================================= -->

        <% } else { %>

          <div class="mb-4">

            <% if (product.stock <= 0) { %>

              <span class="badge bg-danger fs-6">
                <i class="fa-solid fa-circle-xmark me-1"></i>
                Out of Stock
              </span>

            <% } else if (product.stock <= 5) { %>

              <span class="badge bg-warning text-dark fs-6">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                Only <%= product.stock %> left
              </span>

            <% } else { %>

              <span class="badge bg-success fs-6">
                <i class="fa-solid fa-circle-check me-1"></i>
                In Stock — <%= product.stock %> left
              </span>

            <% } %>

          </div>

        <% } %>


        <!-- ========================================= -->
        <!-- COLOUR SELECTION -->
        <!-- ========================================= -->

        <% if (product.colors && product.colors.length > 0) { %>

          <div class="mb-4">

            <label class="form-label fw-bold">
              Select Colour
            </label>

            <select class="form-select product-color" required>

              <option value="">
                Choose colour
              </option>

              <% product.colors.forEach(color => { %>

                <option value="<%= color %>">
                  <%= color %>
                </option>

              <% }) %>

            </select>

          </div>

        <% } %>


        <!-- ========================================= -->
        <!-- QUANTITY -->
        <!-- ========================================= -->

        <div class="mb-4">

          <label class="form-label fw-bold">
            Quantity
          </label>

          <div style="width: 140px;">

            <input
              type="number"
              class="form-control product-quantity"
              value="1"
              min="1"

              <% if (product.category !== "Clothing") { %>
                max="<%= product.stock %>"
              <% } %>

              <% if (
                product.category !== "Clothing" &&
                product.stock <= 0
              ) { %>
                disabled
              <% } %>>

          </div>

          <% if (product.category === "Clothing") { %>

            <small class="text-muted">
              Select a size to see the maximum available quantity.
            </small>

          <% } else if (product.stock > 0) { %>

            <small class="text-muted">
              Maximum available: <%= product.stock %>
            </small>

          <% } %>

        </div>


        <!-- ========================================= -->
        <!-- BUTTONS -->
        <!-- ========================================= -->

        <div class="d-grid gap-3">

          <% if (
            product.category === "Clothing" ||
            product.stock > 0
          ) { %>

            <button
              class="btn btn-warning btn-lg add-to-cart"

              data-id="<%= product._id %>"
              data-name="<%= product.name %>"
              data-price="<%= product.price %>"
              data-image="<%= product.image %>"
              data-stock="<%= product.stock || 0 %>"
              data-category="<%= product.category %>">

              <i class="fa-solid fa-cart-shopping me-2"></i>
              Add to Cart

            </button>

          <% } else { %>

            <button
              class="btn btn-secondary btn-lg"
              disabled>

              <i class="fa-solid fa-ban me-2"></i>
              Out of Stock

            </button>

          <% } %>


          <a href="/checkout" class="btn btn-dark btn-lg">
            Buy Now
          </a>

        </div>

      </div>

    </div>


    <!-- ========================================= -->
    <!-- RELATED PRODUCTS -->
    <!-- ========================================= -->

    <div class="mt-5 pt-5 border-top">

      <h3 class="fw-bold mb-4">
        You May Also Like
      </h3>

      <div class="row g-4">

        <div class="col-md-4">

          <div class="related-card p-3 text-center">

            <h6>TEAM Savage Vest</h6>

            <p class="text-warning fw-bold">
              R349.00
            </p>

          </div>

        </div>


        <div class="col-md-4">

          <div class="related-card p-3 text-center">

            <h6>TEAM Savage Hoodie</h6>

            <p class="text-warning fw-bold">
              R699.00
            </p>

          </div>

        </div>


        <div class="col-md-4">

          <div class="related-card p-3 text-center">

            <h6>TEAM Gym Bag</h6>

            <p class="text-warning fw-bold">
              R599.00
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<%- include("partials/footer") %>