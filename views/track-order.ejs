<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="bg-light py-5 min-vh-100">

  <div class="container py-5">

    <div class="row justify-content-center">

      <div class="col-12 col-md-10 col-lg-7">

        <!-- TRACKING CARD -->
        <div class="card border-0 shadow-lg rounded-4">

          <div class="card-body p-4 p-md-5">

            <!-- HEADER -->
            <div class="text-center mb-5">

              <div
                class="d-inline-flex align-items-center justify-content-center
                       bg-warning bg-opacity-10 rounded-circle mb-3"
                style="width: 80px; height: 80px;">

                <i class="fa-solid fa-location-dot text-warning fa-2x"></i>

              </div>

              <h1 class="fw-bold">
                Track Your Order
              </h1>

              <p class="text-muted mb-0">
                Order #
                <strong>
                  <%= order._id.toString().slice(-6).toUpperCase() %>
                </strong>
              </p>

            </div>


            <!-- STATUS -->
            <div class="mb-5">

              <h5 class="fw-bold mb-4">
                Order Status
              </h5>


              <!-- PENDING -->
              <div class="d-flex align-items-start mb-4">

                <div class="me-3">

                  <% if (
                    ["Pending", "Processing", "Shipped", "Delivered"]
                      .includes(order.status)
                  ) { %>

                    <i class="fa-solid fa-circle-check text-success fa-lg"></i>

                  <% } else { %>

                    <i class="fa-solid fa-circle text-muted fa-lg"></i>

                  <% } %>

                </div>

                <div>

                  <strong>Order Placed</strong>

                  <p class="text-muted small mb-0">
                    Your order has been received.
                  </p>

                </div>

              </div>


              <!-- PROCESSING -->
              <div class="d-flex align-items-start mb-4">

                <div class="me-3">

                  <% if (
                    ["Processing", "Shipped", "Delivered"]
                      .includes(order.status)
                  ) { %>

                    <i class="fa-solid fa-circle-check text-success fa-lg"></i>

                  <% } else { %>

                    <i class="fa-solid fa-circle text-muted fa-lg"></i>

                  <% } %>

                </div>

                <div>

                  <strong>Processing</strong>

                  <p class="text-muted small mb-0">
                    We're preparing your order.
                  </p>

                </div>

              </div>


              <!-- SHIPPED -->
              <div class="d-flex align-items-start mb-4">

                <div class="me-3">

                  <% if (
                    ["Shipped", "Delivered"]
                      .includes(order.status)
                  ) { %>

                    <i class="fa-solid fa-circle-check text-success fa-lg"></i>

                  <% } else { %>

                    <i class="fa-solid fa-circle text-muted fa-lg"></i>

                  <% } %>

                </div>

                <div>

                  <strong>Shipped</strong>

                  <p class="text-muted small mb-0">
                    Your order is on its way.
                  </p>

                </div>

              </div>


              <!-- DELIVERED -->
              <div class="d-flex align-items-start">

                <div class="me-3">

                  <% if (order.status === "Delivered") { %>

                    <i class="fa-solid fa-circle-check text-success fa-lg"></i>

                  <% } else { %>

                    <i class="fa-solid fa-circle text-muted fa-lg"></i>

                  <% } %>

                </div>

                <div>

                  <strong>Delivered</strong>

                  <p class="text-muted small mb-0">
                    Your order has been delivered.
                  </p>

                </div>

              </div>

            </div>


            <!-- CURRENT STATUS -->
            <div class="alert alert-warning border-0 rounded-3">

              <div class="d-flex align-items-center">

                <i class="fa-solid fa-box-open fa-lg me-3"></i>

                <div>

                  <small class="text-muted d-block">
                    Current Status
                  </small>

                  <strong>
                    <%= order.status %>
                  </strong>

                </div>

              </div>

            </div>


            <!-- ORDER TOTAL -->
            <div class="border rounded-3 p-3 mb-4">

              <div class="d-flex justify-content-between">

                <span class="text-muted">
                  Order Total
                </span>

                <strong class="text-warning">
                  R<%= Number(order.total || 0).toFixed(2) %>
                </strong>

              </div>

            </div>


            <!-- BUTTONS -->
            <div class="d-grid gap-3">

              <a
                href="/shop"
                class="btn btn-warning btn-lg">

                <i class="fa-solid fa-store me-2"></i>
                Continue Shopping

              </a>

              <a
                href="/"
                class="btn btn-outline-dark">

                <i class="fa-solid fa-house me-2"></i>
                Back to Home

              </a>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<%- include("partials/footer") %>