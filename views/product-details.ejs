<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="product-details-page py-5 bg-white text-dark">
  <div class="container">

    <div class="row g-5">

      <!-- Product Image -->
      <div class="col-lg-6">

        <!-- MAIN IMAGE -->
        <div class="main-product-image mb-3">

          <img id="mainProductImage"
            src="<%= product.image %>"
            class="img-fluid rounded shadow-sm"
            alt="<%= product.name %>">

        </div>

        <!-- THUMBNAILS -->
        <% if (product.gallery && product.gallery.length > 0) { %>

        <div class="d-flex gap-3 flex-wrap">

          <!-- Main image thumbnail -->
          <img src="<%= product.image %>"
            class="product-thumb active-thumb"
            onclick="changeProductImage(this)"
            alt="Main image">

          <!-- Gallery thumbnails -->
          <% product.gallery.forEach(image => { %>

          <img src="<%= image %>"
            class="product-thumb"
            onclick="changeProductImage(this)"
            alt="Gallery image">

          <% }) %>

        </div>

        <% } %>

      </div>

      <div class="col-lg-6 product-info">

        <h1 class="fw-bold mb-3">
          <%= product.name %>
        </h1>

        <p class="text-warning fw-bold fs-3 mb-3">
          R<%= product.price %>.00
        </p>

        <p class="text-muted mb-4">
          <%= product.description %>
        </p>

        <!-- 🔥 AVAILABLE SIZES -->
        <% if (product.sizes && product.sizes.length > 0) { %>

        <div class="mb-3">

          <label class="form-label fw-bold">
            Available Sizes
          </label>

          <select class="form-select product-size">

            <option value>Choose Size</option>

            <% product.sizes.forEach(size => { %>

            <option value="<%= size %>">
              <%= size %>
            </option>

            <% }) %>

          </select>

        </div>

        <% } %>

        <!-- 🔥 AVAILABLE COLOURS -->
        <% if (product.colors && product.colors.length > 0) { %>

        <div class="mb-4">

          <label class="form-label fw-bold">
            Available Colours
          </label>

          <select class="form-select product-color">

            <option value>Choose Colour</option>

            <% product.colors.forEach(color => { %>

            <option value="<%= color %>">
              <%= color %>
            </option>

            <% }) %>

          </select>

        </div>

        <% } %>

        <!-- 🔥 QUANTITY -->
        <div class="mb-4">

          <label class="form-label fw-bold">
            Quantity
          </label>

          <input type="number"
            value="1"
            min="1"
            class="form-control product-quantity"
            style="max-width: 120px;">

        </div>

        <!-- 🔥 ADD TO CART -->
        <button class="btn btn-warning btn-lg add-to-cart"
          data-id="<%= product._id %>"
          data-name="<%= product.name %>"
          data-price="<%= product.price %>"
          data-image="<%= product.image %>">

          <i class="fa-solid fa-cart-shopping me-2"></i>
          Add to Cart

        </button>

      </div>

    </div>

  </div>
</section>

<script>
  function changeProductImage(src) {

    document.getElementById("mainProductImage").src = src;

    document.querySelectorAll(".product-thumb")
      .forEach(thumb => thumb.classList.remove("active-thumb"));

    event.target.classList.add("active-thumb");
  }
</script>

<%- include("partials/footer") %>