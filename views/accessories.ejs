<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="contact-hero d-flex align-items-center">
  <div class="container text-center">

    <p class="text-warning fw-bold text-uppercase mb-3">
      TEAM SAVAGE
    </p>

    <h1 class="display-3 fw-bold text-white mb-4">
      Accessories Collection
    </h1>

    <p class="lead text-light">
      Complete your setup with bottles, bags, straps, and performance
      accessories.
    </p>

  </div>
</section>

<section class="py-5 bg-white text-dark">
  <div class="container">

    <div class="row g-4">

      <% if (products.length > 0) { %>

        <% products.forEach(product => { %>

          <div class="col-md-6 col-lg-4 col-xl-3">

            <div class="featured-product-card h-100 d-flex flex-column">

              <div class="featured-product-image">
                <img
                  src="<%= product.image %>"
                  alt="<%= product.name %>">
              </div>

              <div class="p-3 d-flex flex-column flex-grow-1">

                <p class="small text-uppercase text-secondary mb-1">
                  <%= product.category %>
                </p>

                <h5 class="fw-bold mb-2">
                  <%= product.name %>
                </h5>

                <p class="fw-bold text-warning fs-5 mb-2">
                  R<%= Number(product.price).toFixed(2) %>
                </p>

                <!-- STOCK STATUS -->
                <div class="mb-3">

                  <% if (!product.stock || product.stock <= 0) { %>

                    <span class="badge bg-danger">
                      <i class="fa-solid fa-circle-xmark me-1"></i>
                      Out of Stock
                    </span>

                  <% } else if (product.stock <= 5) { %>

                    <span class="badge bg-warning text-dark">
                      <i class="fa-solid fa-triangle-exclamation me-1"></i>
                      Only <%= product.stock %> left
                    </span>

                  <% } else { %>

                    <span class="badge bg-success">
                      <i class="fa-solid fa-circle-check me-1"></i>
                      In Stock — <%= product.stock %> left
                    </span>

                  <% } %>

                </div>

                <!-- BUTTONS -->
                <div class="mt-auto d-grid gap-2">

                  <a
                    href="/product/<%= product._id %>"
                    class="btn btn-outline-dark">

                    View Product

                  </a>

                  <% if (!product.stock || product.stock <= 0) { %>

                    <button
                      class="btn btn-secondary"
                      disabled>

                      <i class="fa-solid fa-ban me-2"></i>
                      Out of Stock

                    </button>

                  <% } else { %>

                    <button
                      class="btn btn-warning add-to-cart"
                      data-id="<%= product._id %>"
                      data-name="<%= product.name %>"
                      data-price="<%= product.price %>"
                      data-image="<%= product.image %>"
                      data-stock="<%= product.stock %>">

                      <i class="fa-solid fa-cart-shopping me-2"></i>
                      Add to Cart

                    </button>

                  <% } %>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="col-12 text-center">

          <div class="alert alert-warning">
            No accessories available yet.
          </div>

        </div>

      <% } %>

    </div>

  </div>
</section>

<%- include("partials/footer") %>