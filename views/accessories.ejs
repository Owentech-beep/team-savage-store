<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="contact-hero d-flex align-items-center">
  <div class="container text-center">

    <p class="text-warning fw-bold text-uppercase mb-3">
  TEAM SAVAGE
</p>

<h1 class="display-3 fw-bold text-white mb-4">
  Accessories Collection
</h1>

<p class="lead text-light">
  Complete your setup with bottles, bags, straps, and performance accessories.
</p>

  </div>
</section>

<section class="py-5 bg-white text-dark">
  <div class="container">

    <div class="row g-4">

      <% if (products.length > 0) { %>

        <% products.forEach(product => { %>

          <div class="col-md-6 col-lg-4 col-xl-3">

            <div class="product-card h-100">

              <div class="product-image">
                <img src="<%= product.image %>"
                     class="img-fluid"
                     alt="<%= product.name %>">
              </div>

              <div class="p-3">

                <p class="small text-uppercase text-secondary mb-1">
                  <%= product.category %>
                </p>

                <h5 class="fw-bold mb-2">
                  <%= product.name %>
                </h5>

                <p class="fw-bold text-warning fs-5 mb-3">
                  R<%= product.price %>.00
                </p>

                <div class="d-grid gap-2">

                  <a href="/product/<%= product._id %>"
                     class="btn btn-outline-dark">
                    View Product
                  </a>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="col-12 text-center">
          <div class="alert alert-warning">
            No clothing products available yet.
          </div>
        </div>

      <% } %>

    </div>

    

  </div>
</section>

<%- include("partials/footer") %>