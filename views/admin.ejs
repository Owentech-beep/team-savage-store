<%- include("partials/header") %>

<div class="admin-layout">

  <!-- Desktop Sidebar -->
  <aside class="admin-sidebar">

    <div class="sidebar-brand d-flex align-items-center mb-4">
      <img src="/images/logo.jpeg" alt="TEAM SAVAGE" height="40" class="me-2">
      <span>TEAM SAVAGE</span>
    </div>

    <nav class="sidebar-nav">

      <a href="/admin" class="sidebar-link active">
        <i class="fa-solid fa-chart-line me-2"></i>
        Dashboard
      </a>

      <a href="/shop" class="sidebar-link">
        <i class="fa-solid fa-store me-2"></i>
        Store
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-box me-2"></i>
        Products
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-cart-shopping me-2"></i>
        Orders
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-users me-2"></i>
        Customers
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-gear me-2"></i>
        Settings
      </a>

    </nav>

  </aside>

  <div class="offcanvas offcanvas-start d-lg-none"
    tabindex="-1"
    id="adminSidebar"
    aria-labelledby="adminSidebarLabel">

    <div class="offcanvas-header">

      <h5 class="offcanvas-title fw-bold"
        id="adminSidebarLabel">

        <img src="/images/logo.jpeg"
          alt="TEAM SAVAGE"
          height="32"
          class="me-2">

        TEAM SAVAGE

      </h5>

      <button type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"></button>

    </div>

    <div class="offcanvas-body">

      <nav class="sidebar-nav d-flex flex-column gap-2">

        <a href="/admin" class="sidebar-link active">
          <i class="fa-solid fa-chart-line me-2"></i>
          Dashboard
        </a>

        <a href="/shop" class="sidebar-link">
          <i class="fa-solid fa-store me-2"></i>
          Store
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-box me-2"></i>
          Products
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-cart-shopping me-2"></i>
          Orders
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-users me-2"></i>
          Customers
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-gear me-2"></i>
          Settings
        </a>

      </nav>

    </div>

  </div>

  <!-- Main Content -->
  <main class="admin-main">

    <div class="d-flex justify-content-between align-items-center mb-5">
      <div>
        <h1 class="fw-bold mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, TEAM SAVAGE Admin</p>
      </div>

      <a href="/shop" class="btn btn-dark">
        <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>
        View Store
      </a>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Total Products</p>
            <h2 class="fw-bold mb-0"><%= products.length %></h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Orders Today</p>
            <h2 class="fw-bold mb-0"><%= ordersToday %></h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Revenue</p>
            <h2 class="fw-bold mb-0">R<%= revenue.toFixed(2) %></h2>
          </div>
        </div>
      </div>

    </div>

    <!-- Product Form -->
    <div class="card shadow-sm border-0 mb-5">
      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">Add New Product</h4>

        <form action="/admin/add-product" method="POST" class="row g-3">

          <div class="col-md-6">
            <label class="form-label">Product Name</label>
            <input type="text"
              name="name"
              class="form-control"
              placeholder="Enter any product name"
              required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Category</label>
            <input type="text"
              name="category"
              class="form-control"
              placeholder="e.g. Hoodies, Straps, Supplements"
              required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Price</label>
            <input type="number"
              name="price"
              class="form-control"
              placeholder="499"
              required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Image URL</label>
            <input type="text"
              name="image"
              class="form-control"
              placeholder="/images/tshirt.jpeg"
              required>
          </div>

          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description"
              class="form-control"
              rows="4"
              placeholder="Write any product description"></textarea>
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-warning fw-semibold">
              <i class="fa-solid fa-plus me-2"></i>
              Add Product
            </button>
          </div>

        </form>

      </div>
    </div>

    <!-- Products Table -->
    <div class="card shadow-sm border-0 mt-5">

      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">
          <i class="fa-solid fa-box me-2 text-warning"></i>
          Customer Orders
        </h4>

        <% if (orders.length > 0) { %>

        <div class="table-responsive">

          <table class="table table-hover align-middle">

            <thead class="table-dark">

              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Date</th>
              </tr>

            </thead>

            <tbody>

              <% orders.forEach(order => { %>

              <tr>

                <td class="fw-semibold">
                  <%= order._id.toString().slice(-6).toUpperCase() %>
                </td>

                <td>
                  <div class="fw-semibold">
                    <%= order.customerName || "Guest Customer" %>
                  </div>

                  <small class="text-muted">
                    <%= order.customerEmail || "No email" %>
                  </small>
                </td>

                <td>

                  <% order.items.forEach(item => { %>

                  <div class="small">
                    <%= item.name %> × <%= item.quantity %>
                  </div>

                  <% }) %>

                </td>

                <td class="fw-bold text-warning">
                  R<%= order.total.toFixed(2) %>
                </td>

                <td>
                  <span class="badge bg-secondary">
                    <%= order.paymentMethod || "N/A" %>
                  </span>
                </td>

                <td>

                  <form action="/admin/orders/<%= order._id %>/status"
                    method="POST"
                    class="d-flex gap-2">

                    <select name="status"
                      class="form-select form-select-sm">

                      <option value="Pending"
                        <%=order.status === "Pending" ? "selected" : "" %>>
                        Pending
                      </option>

                      <option value="Processing"
                        <%=order.status === "Processing" ? "selected" : "" %>>
                        Processing
                      </option>

                      <option value="Shipped"
                        <%=order.status === "Shipped" ? "selected" : "" %>>
                        Shipped
                      </option>

                      <option value="Delivered"
                        <%=order.status === "Delivered" ? "selected" : "" %>>
                        Delivered
                      </option>

                    </select>

                    <button type="submit"
                      class="btn btn-warning btn-sm">
                      Update
                    </button>

                  </form>

                </td>

                <td>
                  <%= new Date(order.createdAt).toLocaleDateString() %>
                </td>

              </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

        <% } else { %>

        <div class="alert alert-secondary mb-0">
          No orders have been placed yet.
        </div>

        <% } %>

      </div>
    </div>

    <!-- Products Management -->
<div class="card shadow-sm border-0 mt-5">

  <div class="card-body p-4">

    <h4 class="fw-bold mb-4">
      <i class="fa-solid fa-shirt me-2 text-warning"></i>
      Store Products
    </h4>

    <% if (products && products.length > 0) { %>

      <div class="row g-3">

        <% products.forEach(product => { %>

          <div class="col-md-6 col-lg-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body d-flex flex-column">

                <div class="d-flex align-items-center mb-3">

                  <img src="<%= product.image %>"
                       alt="<%= product.name %>"
                       class="rounded me-3"
                       style="width: 70px; height: 70px; object-fit: cover;">

                  <div>

                    <h6 class="fw-bold mb-1">
                      <%= product.name %>
                    </h6>

                    <small class="text-muted text-uppercase">
                      <%= product.category %>
                    </small>

                  </div>

                </div>

                <p class="fw-bold text-warning fs-5 mb-3">
                  R<%= product.price %>.00
                </p>

                <div class="mt-auto d-grid gap-2">

                  <a href="/product/<%= product._id %>"
                     class="btn btn-outline-dark btn-sm">
                    View Product
                  </a>

                  <!-- 🔥 DELETE BUTTON -->
                  <form action="/admin/delete-product/<%= product._id %>"
                        method="POST"
                        onsubmit="return confirm('Delete this product?')">

                    <button type="submit"
                            class="btn btn-danger btn-sm w-100">

                      <i class="fa-solid fa-trash me-2"></i>
                      Delete Product

                    </button>

                  </form>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <div class="alert alert-secondary mb-0">
        No products available yet.
      </div>

    <% } %>

  </div>

</div>

  </main>

</div>

<%- include("partials/footer") %>