<%- include("partials/header") %>

<div class="admin-layout">

  <!-- Desktop Sidebar -->
  <aside class="admin-sidebar">

    <div class="sidebar-brand d-flex align-items-center mb-4">
      <img src="/images/logo.jpeg" alt="TEAM SAVAGE" height="40" class="me-2">
      <span>TEAM SAVAGE</span>
    </div>

    <nav class="sidebar-nav">

      <a href="/admin" class="sidebar-link active">
        <i class="fa-solid fa-chart-line me-2"></i>
        Dashboard
      </a>

      <a href="/shop" class="sidebar-link">
        <i class="fa-solid fa-store me-2"></i>
        Store
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-box me-2"></i>
        Products
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-cart-shopping me-2"></i>
        Orders
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-users me-2"></i>
        Customers
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-gear me-2"></i>
        Settings
      </a>

    </nav>

  </aside>

  <!-- Mobile Sidebar -->
  <div class="offcanvas offcanvas-start d-lg-none"
    tabindex="-1"
    id="adminSidebar"
    aria-labelledby="adminSidebarLabel">

    <div class="offcanvas-header">

      <h5 class="offcanvas-title fw-bold"
        id="adminSidebarLabel">

        <img src="/images/logo.jpeg"
          alt="TEAM SAVAGE"
          height="32"
          class="me-2">

        TEAM SAVAGE

      </h5>

      <button type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"></button>

    </div>

    <div class="offcanvas-body">

      <nav class="sidebar-nav d-flex flex-column gap-2">

        <a href="/admin" class="sidebar-link active">
          <i class="fa-solid fa-chart-line me-2"></i>
          Dashboard
        </a>

        <a href="/shop" class="sidebar-link">
          <i class="fa-solid fa-store me-2"></i>
          Store
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-box me-2"></i>
          Products
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-cart-shopping me-2"></i>
          Orders
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-users me-2"></i>
          Customers
        </a>

        <a href="#" class="sidebar-link">
          <i class="fa-solid fa-gear me-2"></i>
          Settings
        </a>

      </nav>

    </div>

  </div>

  <!-- Main Content -->
  <main class="admin-main">

    <!-- RESET STORE -->
    <div class="d-flex justify-content-end mb-4">

      <form action="/admin/reset-store"
        method="POST"
        onsubmit="return confirm(' Are you sure? This will delete ALL products and ALL customer orders. This cannot be undone.');">

        <button type="submit"
          class="btn btn-outline-danger">

          <i class="fa-solid fa-trash me-2"></i>
          Reset Store

        </button>

      </form>

    </div>

    <div class="d-flex justify-content-between align-items-center mb-5">
      <div>
        <h1 class="fw-bold mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, TEAM SAVAGE Admin</p>
      </div>

      <a href="/shop" class="btn btn-dark">
        <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>
        View Store
      </a>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Total Products</p>
            <h2 class="fw-bold mb-0"><%= products.length %></h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Orders Today</p>
            <h2 class="fw-bold mb-0"><%= ordersToday %></h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Revenue</p>
            <h2 class="fw-bold mb-0">R<%= revenue.toFixed(2) %></h2>
          </div>
        </div>
      </div>

    </div>

    <!-- Product Form -->
    <div class="card shadow-sm border-0 mb-5">
      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">
          <i class="fa-solid fa-plus me-2 text-warning"></i>
          Add New Product
        </h4>

        <form
          action="/admin/add-product"
          method="POST"
          enctype="multipart/form-data"
          class="row g-3">

          <!-- PRODUCT NAME -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Product Name
            </label>

            <input
              type="text"
              name="name"
              class="form-control"
              required>

          </div>

          <!-- CATEGORY -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Category
            </label>

            <select
              name="category"
              id="productCategory"
              class="form-select"
              required>

              <option value>
                Select Category
              </option>

              <option value="Clothing">
                Clothing
              </option>

              <option value="Accessories">
                Accessories
              </option>

            </select>

          </div>

          <!-- PRICE -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Price
            </label>

            <input
              type="number"
              name="price"
              class="form-control"
              min="0"
              step="0.01"
              required>

          </div>

          <!-- =====================================
           ACCESSORY STOCK
      ====================================== -->
          <div
            class="col-md-6"
            id="generalStockContainer">

            <label class="form-label fw-semibold">
              Stock Quantity
            </label>

            <input
              type="number"
              name="stock"
              id="generalStock"
              class="form-control"
              min="0"
              value="0">

            <small class="text-muted">
              Use this for accessories such as bags,
              bottles and gym straps.
            </small>

          </div>

          <!-- =====================================
           CLOTHING SIZE STOCK
      ====================================== -->
          <div
            class="col-12 d-none"
            id="sizeStockContainer">

            <label class="form-label fw-semibold mb-3">
              Clothing Size & Stock
            </label>

            <div class="row g-3">

              <!-- S -->
              <div class="col-6 col-md-3">

                <div class="border rounded p-3">

                  <label class="form-label fw-bold">
                    Size S
                  </label>

                  <input
                    type="number"
                    name="sizeStock_S"
                    class="form-control size-stock-input"
                    min="0"
                    value="0">

                  <small class="text-muted">
                    Quantity
                  </small>

                </div>

              </div>

              <!-- M -->
              <div class="col-6 col-md-3">

                <div class="border rounded p-3">

                  <label class="form-label fw-bold">
                    Size M
                  </label>

                  <input
                    type="number"
                    name="sizeStock_M"
                    class="form-control size-stock-input"
                    min="0"
                    value="0">

                  <small class="text-muted">
                    Quantity
                  </small>

                </div>

              </div>

              <!-- L -->
              <div class="col-6 col-md-3">

                <div class="border rounded p-3">

                  <label class="form-label fw-bold">
                    Size L
                  </label>

                  <input
                    type="number"
                    name="sizeStock_L"
                    class="form-control size-stock-input"
                    min="0"
                    value="0">

                  <small class="text-muted">
                    Quantity
                  </small>

                </div>

              </div>

              <!-- XL -->
              <div class="col-6 col-md-3">

                <div class="border rounded p-3">

                  <label class="form-label fw-bold">
                    Size XL
                  </label>

                  <input
                    type="number"
                    name="sizeStock_XL"
                    class="form-control size-stock-input"
                    min="0"
                    value="0">

                  <small class="text-muted">
                    Quantity
                  </small>

                </div>

              </div>

            </div>

            <!-- STOCK PREVIEW -->
            <div class="alert alert-light border mt-3 mb-0">

              <i class="fa-solid fa-boxes-stacked me-2 text-warning"></i>

              <strong>Total Clothing Stock:</strong>

              <span id="totalSizeStock">
                0
              </span>

              items

            </div>

          </div>

          <!-- MAIN IMAGE -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Main Product Image
            </label>

            <input
              type="file"
              name="image"
              class="form-control"
              accept="image/*"
              required>

          </div>

          <!-- GALLERY -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Gallery Images (up to 3)
            </label>

            <input
              type="file"
              name="gallery"
              class="form-control"
              accept="image/*"
              multiple>

          </div>

          <!-- DESCRIPTION -->
          <div class="col-12">

            <label class="form-label fw-semibold">
              Description
            </label>

            <textarea
              name="description"
              class="form-control"
              rows="3"></textarea>

          </div>

          <!-- COLOURS -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Available Colours
            </label>

            <input
              type="text"
              name="colors"
              class="form-control"
              placeholder="Black, White, Red">

            <small class="text-muted">
              Separate colours with commas.
            </small>

          </div>

          <!-- SIZES -->
          <div class="col-md-6">

            <label class="form-label fw-semibold">
              Available Sizes
            </label>

            <input
              type="text"
              name="sizes"
              id="availableSizes"
              class="form-control"
              placeholder="S, M, L, XL">

            <small class="text-muted">
              Example: S, M, L, XL
            </small>

          </div>

          <!-- FEATURED -->
          <div class="col-12">

            <div class="form-check">

              <input
                class="form-check-input"
                type="checkbox"
                name="featured"
                value="true"
                id="featuredProduct">

              <label
                class="form-check-label"
                for="featuredProduct">

                Show as Featured Product

              </label>

            </div>

          </div>

          <!-- SUBMIT -->
          <div class="col-12">

            <button
              type="submit"
              class="btn btn-warning fw-semibold">

              <i class="fa-solid fa-plus me-2"></i>

              Add Product

            </button>

          </div>

        </form>

      </div>
    </div>

    <!-- =====================================
     CATEGORY / STOCK JAVASCRIPT
===================================== -->
    <script>

  document.addEventListener("DOMContentLoaded", () => {

    const category =
      document.getElementById("productCategory");

    const generalStockContainer =
      document.getElementById("generalStockContainer");

    const sizeStockContainer =
      document.getElementById("sizeStockContainer");

    const generalStock =
      document.getElementById("generalStock");

    const availableSizes =
      document.getElementById("availableSizes");

    const sizeInputs =
      document.querySelectorAll(".size-stock-input");

    const totalSizeStock =
      document.getElementById("totalSizeStock");


    // =====================================
    // CATEGORY CHANGE
    // =====================================

    category.addEventListener("change", () => {

      if (category.value === "Clothing") {

        // Show size stock
        sizeStockContainer.classList.remove("d-none");

        // Hide general stock
        generalStockContainer.classList.add("d-none");

        // General stock isn't required for clothing
        generalStock.value = 0;


      } else {

        // Hide size stock
        sizeStockContainer.classList.add("d-none");

        // Show general stock
        generalStockContainer.classList.remove("d-none");

        // Clear clothing sizes
        availableSizes.value = "";

        sizeInputs.forEach(input => {
          input.value = 0;
        });

        totalSizeStock.textContent = "0";

      }

    });


    // =====================================
    // CALCULATE TOTAL SIZE STOCK
    // =====================================

    function calculateTotalStock() {

      let total = 0;

      sizeInputs.forEach(input => {

        total += Number(input.value) || 0;

      });

      totalSizeStock.textContent = total;

    }


    sizeInputs.forEach(input => {

      input.addEventListener(
        "input",
        calculateTotalStock
      );

    });


  });

</script>

    <!-- ========================================= -->
    <!-- CUSTOMER ORDERS -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mt-5">

      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">
          <i class="fa-solid fa-box me-2 text-warning"></i>
          Customer Orders
        </h4>

        <% if (orders && orders.length > 0) { %>

        <div class="table-responsive">

          <table class="table table-hover align-middle">

            <thead class="table-dark">

              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Payment Status</th>
                <th>Order Status</th>
                <th>Date</th>
              </tr>

            </thead>

            <tbody>

              <% orders.forEach(order => { %>

              <tr>

                <!-- ORDER ID -->
                <td class="fw-semibold">
                  <%= order._id.toString().slice(-6).toUpperCase() %>
                </td>

                <!-- CUSTOMER -->
                <td>

                  <div class="fw-semibold">
                    <%= order.customerName || "Guest Customer" %>
                  </div>

                  <small class="text-muted">
                    <%= order.customerEmail || "No email" %>
                  </small>

                </td>

                <!-- ITEMS -->
                <td>

                  <% if (order.items && order.items.length > 0) { %>

                  <% order.items.forEach(item => { %>

                  <div class="small">
                    <%= item.name %> × <%= item.quantity %>
                  </div>

                  <% }) %>

                  <% } else { %>

                  <span class="text-muted">
                    No items
                  </span>

                  <% } %>

                </td>

                <!-- TOTAL -->
                <td class="fw-bold text-warning">
                  R<%= Number(order.total || 0).toFixed(2) %>
                </td>

                <!-- PAYMENT METHOD -->
                <td>

                  <span class="badge bg-secondary">
                    <%= order.paymentMethod || "N/A" %>
                  </span>

                </td>

                <!-- PAYMENT STATUS -->
                <td>

                  <% if (order.paymentStatus === "Paid") { %>

                  <span class="badge bg-success">
                    <i class="fa-solid fa-circle-check me-1"></i>
                    PAID
                  </span>

                  <% } else if (order.paymentStatus === "Failed") { %>

                  <span class="badge bg-danger">
                    <i class="fa-solid fa-circle-xmark me-1"></i>
                    FAILED
                  </span>

                  <% } else { %>

                  <span class="badge bg-warning text-dark">
                    <i class="fa-solid fa-clock me-1"></i>
                    PENDING
                  </span>

                  <% if (order.paymentMethod === "EFT") { %>

                  <form
                    action="/admin/orders/<%= order._id %>/payment"
                    method="POST"
                    class="mt-2">

                    <button
                      type="submit"
                      class="btn btn-success btn-sm w-100"
                      onclick="return confirm('Confirm that this EFT payment has been received?')">

                      <i class="fa-solid fa-circle-check me-1"></i>
                      Mark Paid

                    </button>

                  </form>

                  <% } %>

                  <% } %>

                </td>

                <!-- ORDER STATUS -->
                <td>

                  <form
                    action="/admin/orders/<%= order._id %>/status"
                    method="POST"
                    class="d-flex gap-2">

                    <select
                      name="status"
                      class="form-select form-select-sm">

                      <option
                        value="Pending"
                        <%=order.status === "Pending" ? "selected" : "" %>>
                        Pending
                      </option>

                      <option
                        value="Processing"
                        <%=order.status === "Processing" ? "selected" : "" %>>
                        Processing
                      </option>

                      <option
                        value="Shipped"
                        <%=order.status === "Shipped" ? "selected" : "" %>>
                        Shipped
                      </option>

                      <option
                        value="Delivered"
                        <%=order.status === "Delivered" ? "selected" : "" %>>
                        Delivered
                      </option>

                    </select>

                    <button
                      type="submit"
                      class="btn btn-warning btn-sm">

                      Update

                    </button>

                  </form>

                </td>

                <!-- DATE -->
                <td>

                  <%= new Date(order.createdAt).toLocaleDateString() %>

                </td>

              </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

        <% } else { %>

        <div class="alert alert-secondary mb-0">
          No orders have been placed yet.
        </div>

        <% } %>

      </div>

    </div>

    <!-- ========================================= -->
    <!-- PRODUCTS MANAGEMENT -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mt-5">

      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">
          <i class="fa-solid fa-shirt me-2 text-warning"></i>
          Store Products
        </h4>

        <% if (products && products.length > 0) { %>

        <div class="row g-3">

          <% products.forEach(product => { %>

          <div class="col-md-6 col-lg-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body d-flex flex-column">

                <!-- PRODUCT INFO -->
                <div class="d-flex align-items-center mb-3">

                  <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                    class="rounded me-3"
                    style="
                      width: 70px;
                      height: 70px;
                      object-fit: cover;
                    ">

                  <div>

                    <h6 class="fw-bold mb-1">
                      <%= product.name %>
                    </h6>

                    <small class="text-muted text-uppercase">
                      <%= product.category %>
                    </small>

                  </div>

                </div>

                <!-- PRICE -->
                <p class="fw-bold text-warning fs-5 mb-3">
                  R<%= Number(product.price).toFixed(2) %>
                </p>

                <!-- ========================================= -->
                <!-- CLOTHING: SIZE-BASED STOCK -->
                <!-- ========================================= -->

                <% if (product.category === "Clothing") { %>

                <form
                  action="/admin/update-stock/<%= product._id %>"
                  method="POST"
                  class="mb-3">

                  <label class="form-label fw-bold">
                    <i class="fa-solid fa-shirt me-1"></i>
                    Manage Size Stock
                  </label>

                  <% if (product.sizes && product.sizes.length > 0) { %>

                  <div class="row g-2">

                    <% product.sizes.forEach((sizeItem, index) => { %>

                    <div class="col-6">

                      <label class="form-label small mb-1">
                        <%= sizeItem.size %>
                      </label>

                      <input
                        type="hidden"
                        name="sizes[<%= index %>][size]"
                        value="<%= sizeItem.size %>">

                      <input
                        type="number"
                        name="sizes[<%= index %>][stock]"
                        class="form-control"
                        min="0"
                        value="<%= sizeItem.stock ?? 0 %>"
                        required>

                    </div>

                    <% }) %>

                  </div>

                  <% } else { %>

                  <div class="alert alert-warning py-2 mb-3">

                    No sizes have been added for this clothing product.

                  </div>

                  <% } %>

                  <button
                    type="submit"
                    class="btn btn-warning w-100 mt-3">

                    <i class="fa-solid fa-floppy-disk me-2"></i>
                    Save Size Stock

                  </button>

                </form>

                <% } else { %>

                <!-- ========================================= -->
                <!-- ACCESSORIES: NORMAL STOCK -->
                <!-- ========================================= -->
                <!-- STOCK STATUS -->
                <div class="mb-3">

                  <% if ((product.stock ?? 0) <= 0) { %>

                  <span class="badge bg-danger">
                    <i class="fa-solid fa-circle-xmark me-1"></i>
                    Out of Stock
                  </span>

                  <% } else if (product.stock <= 5) { %>

                  <span class="badge bg-warning text-dark">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Low Stock — <%= product.stock %> left
                  </span>

                  <% } else { %>

                  <span class="badge bg-success">
                    <i class="fa-solid fa-circle-check me-1"></i>
                    In Stock — <%= product.stock %> left
                  </span>

                  <% } %>

                </div>

                <!-- ========================================= -->
                <!-- UPDATE STOCK -->
                <!-- ========================================= -->

                <form
                  action="/admin/update-stock/<%= product._id %>"
                  method="POST"
                  class="mb-3">

                  <!-- CLOTHING STOCK BY SIZE -->
                  <% if (product.category === "Clothing") { %>

                  <label class="form-label fw-semibold">
                    Stock by Size
                  </label>

                  <% if (product.sizes && product.sizes.length > 0) { %>

                  <% product.sizes.forEach((sizeItem, index) => { %>

                  <div class="input-group mb-2">

                    <!-- SIZE -->
                    <span class="input-group-text fw-bold">
                      <%= sizeItem.size %>
                    </span>

                    <!-- SEND SIZE NAME -->
                    <input
                      type="hidden"
                      name="sizes[<%= index %>][size]"
                      value="<%= sizeItem.size %>">

                    <!-- SIZE STOCK -->
                    <input
                      type="number"
                      name="sizes[<%= index %>][stock]"
                      class="form-control"
                      min="0"
                      value="<%= sizeItem.stock ?? 0 %>"
                      required>

                    <span class="input-group-text">
                      left
                    </span>

                  </div>

                  <% }) %>

                  <% } else { %>

                  <div class="alert alert-warning py-2">
                    No sizes configured for this product.
                  </div>

                  <% } %>

                  <!-- SAVE CLOTHING STOCK -->
                  <button
                    type="submit"
                    class="btn btn-warning w-100 mt-2">

                    <i class="fa-solid fa-floppy-disk me-2"></i>
                    Save Size Stock

                  </button>

                  <!-- ACCESSORY STOCK -->
                  <% } else { %>

                  <label class="form-label fw-semibold">
                    Stock Quantity
                  </label>

                  <div class="input-group">

                    <input
                      type="number"
                      name="stock"
                      class="form-control"
                      min="0"
                      value="<%= product.stock ?? 0 %>"
                      required>

                    <button
                      type="submit"
                      class="btn btn-warning">

                      <i class="fa-solid fa-floppy-disk"></i>

                    </button>

                  </div>

                  <% } %>

                </form>

                <% } %>

                <!-- ACTIONS -->
                <div class="mt-auto d-grid gap-2">

                  <a
                    href="/product/<%= product._id %>"
                    class="btn btn-outline-dark btn-sm">

                    View Product

                  </a>

                  <form
                    action="/admin/delete-product/<%= product._id %>"
                    method="POST"
                    onsubmit="return confirm('Delete this product?')">

                    <button
                      type="submit"
                      class="btn btn-danger btn-sm w-100">

                      <i class="fa-solid fa-trash me-2"></i>
                      Delete Product

                    </button>

                  </form>

                </div>

              </div>

            </div>

          </div>

          <% }) %>

        </div>

        <% } else { %>

        <div class="alert alert-secondary mb-0">
          No products available yet.
        </div>

        <% } %>

      </div>

    </div>

  </main>

</div>

<%- include("partials/footer") %>