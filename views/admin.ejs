<%- include("partials/header") %>

<div class="admin-layout">

  <!-- Sidebar -->
  <aside class="admin-sidebar">

    <div class="sidebar-brand d-flex align-items-center mb-4">
      <img src="/images/logo.jpeg" alt="TEAM SAVAGE" height="40" class="me-2">
      <span>TEAM SAVAGE</span>
    </div>

    <nav class="sidebar-nav">

      <a href="/admin" class="sidebar-link active">
        <i class="fa-solid fa-chart-line me-2"></i>
        Dashboard
      </a>

      <a href="/shop" class="sidebar-link">
        <i class="fa-solid fa-store me-2"></i>
        Store
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-box me-2"></i>
        Products
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-cart-shopping me-2"></i>
        Orders
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-users me-2"></i>
        Customers
      </a>

      <a href="#" class="sidebar-link">
        <i class="fa-solid fa-gear me-2"></i>
        Settings
      </a>

    </nav>

  </aside>

  <!-- Main Content -->
  <main class="admin-main">

    <div class="d-flex justify-content-between align-items-center mb-5">
      <div>
        <h1 class="fw-bold mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, TEAM SAVAGE Admin</p>
      </div>

      <a href="/shop" class="btn btn-dark">
        <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>
        View Store
      </a>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Total Products</p>
            <h2 class="fw-bold"><%= products.length %></h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Orders Today</p>
            <h2 class="fw-bold">0</h2>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <p class="text-muted mb-1">Revenue</p>
            <h2 class="fw-bold">R0.00</h2>
          </div>
        </div>
      </div>

    </div>

    <!-- Product Form -->
    <div class="card shadow-sm border-0 mb-5">
      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">Add New Product</h4>

        <form class="row g-3">

          <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Product name">
          </div>

          <div class="col-md-3">
            <select class="form-select">
              <option>T-Shirts</option>
              <option>Vests</option>
              <option>Hoodies</option>
              <option>Bags</option>
            </select>
          </div>

          <div class="col-md-3">
            <input type="number" class="form-control" placeholder="Price">
          </div>

          <div class="col-12">
            <button type="button" class="btn btn-warning px-4">
              <i class="fa-solid fa-plus me-2"></i>
              Add Product
            </button>
          </div>

        </form>

      </div>
    </div>

    <!-- Products Table -->
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">

        <h4 class="fw-bold mb-4">Current Products</h4>

        <div class="table-responsive">

          <table class="table align-middle">

            <thead class="table-dark">
              <tr>
                <th>ID</th>
                <th>Product</th>
                <th>Category</th>
                <th>Price</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>

              <% products.forEach(product => { %>

                <tr>

                  <td><%= product.id %></td>

                  <td class="fw-semibold">
                    <%= product.name %>
                  </td>

                  <td>
                    <span class="badge bg-secondary">
                      <%= product.category %>
                    </span>
                  </td>

                  <td class="fw-bold text-warning">
                    R<%= product.price %>.00
                  </td>

                  <td>
                    <div class="d-flex gap-2">

                      <a href="/product/<%= product.id %>"
                         class="btn btn-sm btn-outline-dark">
                        <i class="fa-solid fa-eye"></i>
                      </a>

                      <button class="btn btn-sm btn-outline-warning">
                        <i class="fa-solid fa-pen"></i>
                      </button>

                      <button class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-trash"></i>
                      </button>

                    </div>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      </div>
    </div>

  </main>

</div>

<%- include("partials/footer") %>