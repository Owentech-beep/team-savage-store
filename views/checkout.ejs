<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="py-5 mt-5 bg-white text-dark">
    <div class="container">

        <h1 class="fw-bold mb-5">Checkout</h1>

        <div class="row g-5">

            <!-- Customer Details -->
            <div class="col-lg-7">

                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">Customer Information</h4>

                        <form id="checkout-form">

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">First Name</label>
                                    <input
                                        type="text"
                                        name="firstName"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Last Name</label>
                                    <input
                                        type="text"
                                        name="lastName"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input
                                        type="email"
                                        name="email"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Phone
                                        Number</label>
                                    <input
                                        type="tel"
                                        name="phone"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Street
                                        Address</label>
                                    <input
                                        type="text"
                                        name="street"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">City</label>
                                    <input
                                        type="text"
                                        name="city"
                                        class="form-control"
                                        required>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Province</label>

                                    <select
                                        class="form-select"
                                        name="province"
                                        required>

                                        <option value>Province</option>
                                        <option>Eastern Cape</option>
                                        <option>Free State</option>
                                        <option>Gauteng</option>
                                        <option>KwaZulu-Natal</option>
                                        <option>Limpopo</option>
                                        <option>Mpumalanga</option>
                                        <option>North West</option>
                                        <option>Northern Cape</option>
                                        <option>Western Cape</option>

                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Postal
                                        Code</label>

                                    <input
                                        type="text"
                                        name="postalCode"
                                        class="form-control"
                                        required>
                                </div>

                            </div>

                        </form>

                    </div>
                </div>

            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Order Summary</h4>

                        <div id="checkout-items" class="mb-4"></div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span id="checkout-subtotal">R0.00</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Delivery Fee</span>
                            <span id="checkout-delivery">R100.00</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>VAT</span>
                            <span>Included</span>
                        </div>

                        <hr>

                        <div
                            class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span id="checkout-total">R100.00</span>
                        </div>

                        <!-- Payment Methods -->

                        <div class="mb-3">
                            <h6 class="fw-bold mb-3">Payment Method</h6>

                            <div class="form-check border rounded p-3 mb-2">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="paymentMethod"
                                    id="eftPayment"
                                    value="EFT"
                                    checked>

                                <label
                                    class="form-check-label fw-semibold"
                                    for="eftPayment">

                                    <i
                                        class="fa-solid fa-building-columns me-2"></i>
                                    EFT / Bank Transfer

                                </label>
                            </div>

                            <div class="form-check border rounded p-3">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="paymentMethod"
                                    id="payfastPayment"
                                    value="Payfast">

                                <label
                                    class="form-check-label fw-semibold"
                                    for="payfastPayment">

                                    <i class="fa-solid fa-credit-card me-2"></i>
                                    Payfast

                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-3">

                            <button
                                type="button"
                                onclick="handlePayment()"
                                class="btn btn-warning w-100 btn-lg">

                                <i class="fa-solid fa-lock me-2"></i>
                                Continue to Payment

                            </button>

                        </div>

                        <p class="small text-muted mt-3 mb-0">
                            Secure payments powered by TEAM SAVAGE Commerce.
                        </p>
                    </div>
                </div>
            </div>

            <script>

async function getCustomerDetails() {

    return {

        firstName:
            document.querySelector('[name="firstName"]').value.trim(),

        lastName:
            document.querySelector('[name="lastName"]').value.trim(),

        email:
            document.querySelector('[name="email"]').value.trim(),

        phone:
            document.querySelector('[name="phone"]').value.trim(),

        street:
            document.querySelector('[name="street"]').value.trim(),

        city:
            document.querySelector('[name="city"]').value.trim(),

        province:
            document.querySelector('[name="province"]').value,

        postalCode:
            document.querySelector('[name="postalCode"]').value.trim(),

    };

}


// =====================================
// HANDLE PAYMENT METHOD
// =====================================

async function handlePayment() {

    const paymentMethod =
        document.querySelector(
            'input[name="paymentMethod"]:checked'
        ).value;

    if (paymentMethod === "EFT") {

        await placeOrder("EFT");

    }

    if (paymentMethod === "Payfast") {

        await startPayfastPayment();

    }

}


// =====================================
// CREATE EFT ORDER
// =====================================

async function createOrder(paymentMethod) {

    const cart =
        JSON.parse(localStorage.getItem("cart")) || [];

    if (cart.length === 0) {

        alert("Your cart is empty.");

        return null;

    }

    const form =
        document.getElementById("checkout-form");

    if (!form.checkValidity()) {

        form.reportValidity();

        return null;

    }

    const customer =
        await getCustomerDetails();

    const subtotal = cart.reduce(
        (sum, item) =>
            sum +
            Number(item.price) *
            Number(item.quantity),
        0
    );

    const deliveryFee = 100;

    const total =
        subtotal + deliveryFee;

    const orderData = {

        customerName:
            `${customer.firstName} ${customer.lastName}`,

        customerEmail:
            customer.email,

        customerPhone:
            customer.phone,

        address: {

            street:
                customer.street,

            city:
                customer.city,

            province:
                customer.province,

            postalCode:
                customer.postalCode,

        },

       items: cart.map(item => ({
            productId: item.id,
            name: item.name,
            price: item.price,
            image: item.image,
            stock: item.stock,
            size: item.size,
            color: item.color,
            quantity: item.quantity
        })),

        subtotal,

        deliveryFee,

        total,

        paymentMethod,

    };


    const response = await fetch(
        "/api/orders",
        {

            method: "POST",

            headers: {

                "Content-Type":
                    "application/json",

            },

            body:
                JSON.stringify(orderData),

        }
    );


    const result =
        await response.json();


    if (!response.ok || !result.success) {

        throw new Error(
            result.message ||
            "Unable to create order."
        );

    }


    console.log(
        "Order created:",
        result.orderId
    );


    return result.orderId;

}


// =====================================
// EFT ORDER
// =====================================

async function placeOrder(paymentMethod) {

    try {

        const orderId =
            await createOrder(paymentMethod);

        if (!orderId) {

            return;

        }

        localStorage.removeItem("cart");

        window.location.href =
            `/eft-payment/${orderId}`;

    } catch (error) {

        console.error(error);

        alert(
            error.message ||
            "Something went wrong while placing your order."
        );

    }

}


// =====================================
// PAYFAST PAYMENT
// =====================================

async function startPayfastPayment() {

    try {

        const cart =
            JSON.parse(localStorage.getItem("cart")) || [];

        if (cart.length === 0) {

            alert("Your cart is empty.");

            return;

        }

        const form =
            document.getElementById("checkout-form");

        if (!form.checkValidity()) {

            form.reportValidity();

            return;

        }

        const customer =
            await getCustomerDetails();


        const response = await fetch(
            "/api/payfast/create",
            {

                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json",

                },

                body: JSON.stringify({

                    customerName:
                        `${customer.firstName} ${customer.lastName}`,

                    customerEmail:
                        customer.email,

                    customerPhone:
                        customer.phone,

                    address: {

                        street:
                            customer.street,

                        city:
                            customer.city,

                        province:
                            customer.province,

                        postalCode:
                            customer.postalCode,

                    },

                    items: cart.map(item => ({
                        productId: item.id,
                        name: item.name,
                        price: item.price,
                        image: item.image,
                        stock: item.stock,
                        size: item.size,
                        color: item.color,
                        quantity: item.quantity
                    })),

                }),

            }
        );


        const result =
            await response.json();


        if (!response.ok || !result.success) {

            throw new Error(
                result.message ||
                "Unable to start Payfast payment."
            );

        }


        console.log(
            "Payfast order created:",
            result.orderId
        );


        // =====================================
        // BUILD PAYFAST FORM
        // =====================================

        const payfastForm =
            document.createElement("form");

        payfastForm.method = "POST";

        payfastForm.action =
            result.payfastUrl;


        Object.entries(result.payfastData)
            .forEach(([key, value]) => {

                const input =
                    document.createElement("input");

                input.type = "hidden";

                input.name = key;

                input.value = value;

                payfastForm.appendChild(input);

            });


        document.body.appendChild(
            payfastForm
        );


        // =====================================
        // REDIRECT TO PAYFAST
        // =====================================

        localStorage.removeItem("cart");

        payfastForm.submit();

    } catch (error) {

        console.error(
            "Payfast error:",
            error
        );

        alert(
            error.message ||
            "Unable to start Payfast payment."
        );

    }

}

</script>

        </div>

    </div>
</section>

<script src="/js/main.js"></script>

<%- include("partials/footer") %>
